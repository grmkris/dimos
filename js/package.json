{
  "name": "dimos-js",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "@eclipse-zenoh/zenoh-ts": "1.9.0",
      "@rerun-io/web-viewer-react": "0.32.0-alpha.1",
      "@tensorflow-models/coco-ssd": "^2.2.3",
      "@tensorflow/tfjs": "^4.22.0",
      "@types/bun": "^1.3.14",
      "@types/node": "^26.0.1",
      "@types/react": "^18.3.12",
      "@types/react-dom": "^18.3.1",
      "@typescript/native-preview": "7.0.0-dev.20260627.2",
      "@vitejs/plugin-react": "^4.3.4",
      "errore": "^0.14.0",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "tsdown": "^0.22.3",
      "typescript": "^6.0.3",
      "vite": "^5.4.11",
      "vite-plugin-top-level-await": "^1.6.0",
      "vite-plugin-wasm": "^3.6.0",
      "zod": "4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "oxfmt --check . && oxlint --type-aware --type-check .",
    "dev": "turbo dev",
    "fix": "oxfmt . && oxlint --fix --type-aware --type-check .",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "ci:local": "turbo lint typecheck test build --concurrency=1"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
